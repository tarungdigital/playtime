# Copy to .env and fill in (start.bat does the copy for you on first run).
# Stations, prices and the Tapo login are managed in the admin panel at /admin.

# --- Required -------------------------------------------------------------------

# CHIP Collect: gate.chip-in.asia > Developers. Start with your test secret key.
CHIP_SECRET_KEY=
CHIP_BRAND_ID=
# CHIP needs a client email on every purchase; receipts are sent here.
CHIP_CLIENT_EMAIL=

# Public https address of this server, without a port. Leave empty and start.bat
# fills it in with a temporary quick tunnel; put your own domain here for real use.
PUBLIC_URL=

# Password for the admin panel. Use a long random one.
ADMIN_TOKEN=

# --- Optional: uncomment to change (defaults shown) --------------------------------

# true = simulate the plugs, to try everything without hardware.
# PLUG_DRY_RUN=false

# Name shown at the top of every page.
# SHOP_NAME=Playtime

# Only offer these payment methods at checkout, comma separated (empty = all your CHIP
# account offers). Codes include: duitnow_qr, fpx, razer_tng, razer_grabpay,
# razer_shopeepay, razer_maybankqr, razer_atome, visa, mastercard, mpgs_apple_pay,
# mpgs_google_pay. Unknown codes are reported in the log when the app starts.
# CHIP_PAYMENT_METHOD=duitnow_qr,fpx,razer_tng

# Open checkout straight on one payment method, e.g. duitnow_qr or fpx.
# CHIP_PREFERRED_METHOD=

# Time zone for "today" and "this month" in the admin stats (Malaysia = 8).
# UTC_OFFSET_HOURS=8

# How often (seconds) every plug is checked and switched to match paid time.
# CHECK_INTERVAL_SECONDS=15
