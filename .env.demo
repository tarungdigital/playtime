# Demo settings: fake plugs and placeholder CHIP keys, for trying the pages locally.
# Run: uvicorn app.main:app --env-file .env.demo
# The Pay button won't work with these keys; use the admin endpoint to start a timer.
PLAYTIME_ENV_FILE=.env.demo
SHOP_NAME=Playtime
CHIP_SECRET_KEY=demo
CHIP_BRAND_ID=demo
CHIP_CLIENT_EMAIL=demo@example.com
PUBLIC_URL=http://localhost:8000
PLUG_DRY_RUN=true
STATIONS=switch1=192.168.1.50,switch2=192.168.1.51
ADMIN_TOKEN=demo
DB_PATH=demo.db
